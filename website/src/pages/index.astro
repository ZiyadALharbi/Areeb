---
// biome-ignore-all lint/correctness/noUnusedImports: components are used in the template
import Architecture from "../components/Architecture.astro";
import Capabilities from "../components/Capabilities.astro";
import InstallControl from "../components/InstallControl.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import Wordmark from "../components/Wordmark.astro";
import "../styles/global.css";

const _githubUrl = "https://github.com/ZiyadALharbi/Areeb";
const _npmUrl = "https://www.npmjs.com/package/@ziyad_1440/areeb";
const _xUrl = "https://x.com/Ziyad_1440";
const _piUrl = "https://github.com/earendil-works/pi";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Areeb is a small coding agent for your terminal, inspired by Pi. It understands your intent, works through the code, and verifies the result."
    />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/png" href="/areeb-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>Areeb — A sharp mind for your codebase</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <div class="header-bar">
        <a class="brand" href="#top" aria-label="Areeb, back to top">
          <img src="/areeb-mark.png" alt="" width="26" height="26" />
          <span>Areeb</span>
        </a>

        <nav class="header-nav" aria-label="Primary">
          <a href="#features">Features</a>
          <a href="#architecture">Architecture</a>
          <a href="#name">The name</a>
        </nav>

        <div class="header-actions">
          <a class="icon-link icon-link-x" href={_xUrl} target="_blank" rel="noreferrer" aria-label="Areeb on X (opens in a new tab)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"></path>
            </svg>
          </a>
          <a class="icon-link" href={_githubUrl} target="_blank" rel="noreferrer" aria-label="Areeb on GitHub (opens in a new tab)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.588 2 12.25c0 4.53 2.865 8.374 6.839 9.73.5.095.682-.222.682-.494 0-.244-.009-.89-.014-1.746-2.782.62-3.369-1.374-3.369-1.374-.455-1.183-1.11-1.498-1.11-1.498-.908-.636.069-.623.069-.623 1.003.073 1.531 1.056 1.531 1.056.892 1.568 2.341 1.115 2.91.853.091-.663.349-1.115.635-1.372-2.221-.259-4.555-1.139-4.555-5.066 0-1.119.389-2.034 1.029-2.751-.103-.26-.446-1.302.098-2.713 0 0 .84-.276 2.75 1.05A9.318 9.318 0 0 1 12 6.987a9.32 9.32 0 0 1 2.504.345c1.91-1.326 2.749-1.05 2.749-1.05.545 1.411.202 2.453.1 2.713.64.717 1.027 1.632 1.027 2.751 0 3.937-2.338 4.804-4.566 5.058.359.317.679.943.679 1.902 0 1.373-.013 2.48-.013 2.817 0 .274.18.594.688.493C19.14 20.62 22 16.78 22 12.25 22 6.588 17.523 2 12 2Z" clip-rule="evenodd"></path>
            </svg>
          </a>
          <a class="pill-button" href="#install">Install</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero shell" id="top" aria-labelledby="hero-title">
        <a class="badge" href={_npmUrl} target="_blank" rel="noreferrer">
          <span class="badge-dot" aria-hidden="true"></span>
          v0.2.0 · open source · MIT
        </a>

        <Wordmark />

        <h1 id="hero-title" class="hero-tagline">
          <span class="sr-only">Areeb, أريب. </span>A sharp mind for your codebase.
        </h1>
        <p class="hero-copy">
          Areeb is a small coding agent for your terminal, inspired by Pi. It understands your intent,{" "}
          <strong>works through the code, and verifies the result.</strong>
        </p>

        <div class="hero-install">
          <InstallControl id="hero" />
        </div>

        <div class="hero-links">
          <a href={_githubUrl} target="_blank" rel="noreferrer">Read the source <span aria-hidden="true">↗</span></a>
          <a href={_npmUrl} target="_blank" rel="noreferrer">View on npm <span aria-hidden="true">↗</span></a>
        </div>

        <div class="demo">
          <TerminalDemo />
        </div>
      </section>

      <Capabilities />

      <Architecture />

      <section class="section shell" id="name" aria-labelledby="name-title">
        <div class="section-head reveal">
          <span class="kicker">The name</span>
          <h2 id="name-title">Why Areeb</h2>
        </div>

        <article class="entry card reveal">
          <span class="entry-word" lang="ar" dir="rtl">أَرِيب</span>
          <div class="entry-body">
            <div class="entry-head">
              <strong>Areeb</strong>
              <span>/ʔa.riːb/ · adjective · Arabic</span>
            </div>
            <p class="entry-definition">Perceptive. Intelligent. Skilled at seeing what others miss.</p>
            <p>
              The name points to a kind of intelligence that is useful, attentive, and exact. Areeb
              means possessing sound judgment and high intellect.
            </p>
          </div>
        </article>

        <div class="origins">
          <a class="origin card reveal" href={_piUrl} target="_blank" rel="noreferrer">
            <span class="origin-mark" aria-hidden="true">π</span>
            <div>
              <h3>Inspired by Pi</h3>
              <p>Built on Pi's idea of a lean, composable coding agent.</p>
            </div>
            <span class="origin-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="origin card reveal" href={_githubUrl} target="_blank" rel="noreferrer">
            <span class="origin-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M8.7 16.3 4.4 12l4.3-4.3-1.4-1.4L1.6 12l5.7 5.7 1.4-1.4Zm6.6 0 4.3-4.3-4.3-4.3 1.4-1.4 5.7 5.7-5.7 5.7-1.4-1.4Z"></path></svg>
            </span>
            <div>
              <h3>Meant to be read</h3>
              <p>A learning project. Every layer is small enough to follow end to end.</p>
            </div>
            <span class="origin-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="section shell" id="install" aria-labelledby="install-title">
        <div class="finale card reveal">
          <span class="kicker">Ready when you are</span>
          <h2 id="install-title">Bring a sharp mind into your codebase.</h2>
          <p>One command. Then tell Areeb what you want to build.</p>

          <InstallControl id="final" />

          <ol class="steps">
            <li>
              <code>cd my-project && areeb</code>
              <span>Start Areeb in the project you want it to work on.</span>
            </li>
            <li>
              <code>/login</code>
              <span>Connect an OpenAI API key or a ChatGPT Plus/Pro subscription.</span>
            </li>
            <li>
              <code>/model</code>
              <span>Pick a model, then type a request and press Enter.</span>
            </li>
          </ol>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <a class="brand" href="#top" aria-label="Areeb, back to top">
        <img src="/areeb-mark.png" alt="" width="26" height="26" />
        <span>Areeb</span>
      </a>
      <nav class="footer-links" aria-label="Footer">
        <a href={_githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={_npmUrl} target="_blank" rel="noreferrer">npm</a>
        <a href={_xUrl} target="_blank" rel="noreferrer">X</a>
        <a href={_piUrl} target="_blank" rel="noreferrer">Pi</a>
      </nav>
      <p>© {new Date().getFullYear()} Areeb · MIT License</p>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>("[data-header]");
      const updateHeader = () => header?.classList.toggle("is-compact", window.scrollY > 40);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      const revealItems = document.querySelectorAll<HTMLElement>(".reveal");
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        revealItems.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
